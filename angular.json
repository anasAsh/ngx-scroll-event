{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-scroll-event": {
      "projectType": "library",
      "root": "projects/ngx-scroll-event",
      "sourceRoot": "projects/ngx-scroll-event/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-scroll-event/tsconfig.lib.json",
            "project": "projects/ngx-scroll-event/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-scroll-event/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ngx-scroll-event/src/test.ts",
            "tsConfig": "projects/ngx-scroll-event/tsconfig.spec.json",
            "karmaConfig": "projects/ngx-scroll-event/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "projects/ngx-scroll-event/tsconfig.lib.json",
              "projects/ngx-scroll-event/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "e2e-app": {
      "projectType": "application",
      "root": "projects/e2e-app",
      "sourceRoot": "projects/e2e-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/e2e-app",
            "index": "projects/e2e-app/src/index.html",
            "browser": "projects/e2e-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/e2e-app/tsconfig.app.json",
            "assets": [],
            "styles": [
              "projects/e2e-app/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "e2e-app:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "e2e-app:build:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "aa4057d1-dc44-4494-8179-edae509daebf"
  },
  "defaultProject": "ngx-scroll-event"
}