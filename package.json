  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng build ngx-scroll-event && npx playwright test",
    "e2e:headed": "ng build ngx-scroll-event && npx playwright test --headed",
    "build:lib": "ng build ngx-scroll-event",
    "release:prep": "npm run build:lib && echo \"Next: cd dist/ngx-scroll-event && npm publish\""
  },
  "private": true,
